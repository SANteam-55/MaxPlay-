{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/proxy/(.*)", "destination": "/api/index.ts" },
    { "source": "/((?!api/|proxy/).*)", "destination": "/index.html" }
  ]
}
